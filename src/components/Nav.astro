---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/styleguide', label: 'Style Guide' },
]
const path = Astro.url.pathname
---

<nav class="nav">
  {
    links.map((l) => (
      <a href={l.href} class:list={['nav__link', { 'is-active': path === l.href }]}>
        {l.label}
      </a>
    ))
  }
</nav>

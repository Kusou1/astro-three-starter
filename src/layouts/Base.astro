---
import '@/styles/global.scss'
import { ClientRouter } from 'astro:transitions'
import Nav from '@/components/Nav.astro'

const {
  title = 'astro-three-starter',
  description = 'Astro + vanilla three persistent-canvas starter',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- ClientRouter: intercepts link clicks + popstate, swaps DOM instead of
         full reload. This is what lets the canvas below stay alive.
         fallback="swap": browsers WITHOUT the View Transitions API (e.g. Sogou /
         older Chromium cores) otherwise get Astro's simulated CSS crossfade,
         which flashes over the persistent canvas. Transitions are GSAP-driven,
         so those browsers just swap the DOM instantly — no fade, no flash. -->
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <!-- 持久 3D 层：住在 LAYOUT 里、标了 transition:persist，所以它（连同 WebGPU
         context）跨每次导航存活。vanilla 版用一个裸 <canvas>，由下面的 script 调
         initCanvas3D() 初始化一次（不像 R3F 版是个 React island）。 -->
    <div id="canvas-root" transition:persist>
      <canvas></canvas>
    </div>

    <Nav />

    <!-- Custom overlay scrollbar (native root scrollbar hidden in global.scss).
         transition:persist so it survives ClientRouter swaps; lib/scrollbar.js
         wires the behaviour once. -->
    <div id="scrollbar" transition:persist aria-hidden="true">
      <div id="scrollbar-bar"></div>
    </div>

    <main>
      <slot />
    </main>

    <script>
      import { initCanvas3D } from '@/canvas/canvas3d'
      import { initTransitions } from '@/lib/transitions'
      import { initScroll } from '@/lib/scroll'
      import { initScrollBar } from '@/lib/scrollbar'
      // module script：Astro 去重、只跑一次（不随 ClientRouter 导航重执行）。
      // 各自幂等：canvas 只 init 一次，transitions/scroll/scrollbar 只注册一次监听。
      initCanvas3D()
      initTransitions()
      initScroll()
      initScrollBar()
    </script>
  </body>
</html>
